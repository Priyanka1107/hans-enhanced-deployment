# HANS environment
HANS_ENVIRONMENT=development
HANS_API_HOST=127.0.0.1
HANS_API_PORT=8009

# Internal authentication between workflow client and HANS
HANS_INTERNAL_API_KEY=replace-with-local-secret

# Database
DATABASE_URL=postgresql://hans_enhanced:hans_enhanced_dev@127.0.0.1:5434/hans_enhanced

# Generation provider
# Options:
# htw_ollama
# mistral_api
GENERATION_PROVIDER=htw_ollama

# Ollama-compatible local/HTW model
OLLAMA_BASE_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435
OLLAMA_MODEL=mistral-small:24b
OLLAMA_VERIFY_SSL=true
OLLAMA_TIMEOUT=420
OLLAMA_MAX_ATTEMPTS=6

# Mistral Cloud alternative
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=
MISTRAL_TIMEOUT=180
MISTRAL_MAX_TOKENS=1200
MISTRAL_MAX_ATTEMPTS=3

# Safety
THREAD_MEMORY_ENABLED=true
STAFF_REVIEW_REQUIRED_FOR_ALL=true

# Optional Langfuse observability
# Disabled by default; never commit real keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keep false unless prompt/email content capture is explicitly approved.
LANGFUSE_CAPTURE_CONTENT=false

# Experimental token-efficiency controls.
# These are ignored unless HANS_EXPERIMENT_MODE=true.
HANS_EXPERIMENT_MODE=false
HANS_EXPERIMENT_LABEL=control
HANS_EXPERIMENT_ALLOW_EXACT_TOP_K=false
HANS_EXPERIMENT_DEDUPE_URLS=false
HANS_EXPERIMENT_EVIDENCE_CHAR_LIMIT=1800
