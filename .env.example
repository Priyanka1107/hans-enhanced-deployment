# HANS environment
HANS_ENVIRONMENT=development
HANS_API_HOST=127.0.0.1
HANS_API_PORT=8009

# Internal authentication between workflow client and HANS
HANS_INTERNAL_API_KEY=replace-with-local-secret

# Database
DATABASE_URL=postgresql://hans_enhanced:hans_enhanced_dev@127.0.0.1:5434/hans_enhanced

# Generation provider
# Options:
# htw_litellm
# htw_ollama
# mistral_api
GENERATION_PROVIDER=htw_ollama

# HTW OpenAI-compatible LiteLLM endpoint
# Keep the real API key only in the local/server environment. Never commit it.
LITELLM_BASE_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435/v1
LITELLM_CHAT_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435/v1/chat/completions
LITELLM_API_KEY=
LITELLM_MODEL=qwen3.8-27b
LITELLM_VERIFY_TLS=true
LITELLM_TRUST_ENV=true
LITELLM_TIMEOUT=420
LITELLM_MAX_ATTEMPTS=6

# Ollama-compatible local/HTW model
OLLAMA_BASE_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435
OLLAMA_MODEL=mistral-small:24b
OLLAMA_VERIFY_SSL=true
OLLAMA_TIMEOUT=420
OLLAMA_MAX_ATTEMPTS=6

# Mistral Cloud alternative
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=
MISTRAL_TIMEOUT=180
MISTRAL_MAX_TOKENS=1200
MISTRAL_MAX_ATTEMPTS=3

# Safety
THREAD_MEMORY_ENABLED=true
STAFF_REVIEW_REQUIRED_FOR_ALL=true


# Mailbox integration for staff UI
# Reading inbox messages does not call the LLM.
HANS_MAILBOX_ENABLED=false
HANS_MAILBOX_PROVIDER=imap
HANS_IMAP_HOST=
HANS_IMAP_PORT=993
HANS_IMAP_USERNAME=
HANS_IMAP_PASSWORD=
HANS_IMAP_FOLDER=INBOX
HANS_IMAP_DRAFTS_FOLDER=Drafts
HANS_IMAP_USE_SSL=true

# Staff-reviewed mailbox write actions
# Draft writing and sending are separate opt-ins.
HANS_MAILBOX_WRITE_ENABLED=false
HANS_MAILBOX_SEND_ENABLED=false

# SMTP configuration for explicit staff-triggered sending.
# Username/password fall back to the IMAP values when left blank.
HANS_SMTP_HOST=
HANS_SMTP_PORT=465
HANS_SMTP_USERNAME=
HANS_SMTP_PASSWORD=
HANS_SMTP_USE_SSL=true
HANS_SMTP_STARTTLS=false
