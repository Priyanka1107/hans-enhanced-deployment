# ============================================================
# HANS Test Server Configuration
# Release: 63653f7
# ============================================================

# ------------------------------------------------------------
# HANS API
# ------------------------------------------------------------
HANS_ENVIRONMENT=production
HANS_API_HOST=127.0.0.1
HANS_API_PORT=8009

# Internal authentication.
# Replace this with a new server-specific secret.
HANS_INTERNAL_API_KEY=replace-with-server-secret


# ------------------------------------------------------------
# PostgreSQL + pgvector
# ------------------------------------------------------------
# Replace user, password, host, port and database name with the
# values created on the test server.
DATABASE_URL=postgresql://<db_user>:<db_password>@127.0.0.1:5432/<db_name>


# ------------------------------------------------------------
# Generation: HTW LiteLLM
# ------------------------------------------------------------
GENERATION_PROVIDER=htw_litellm

LITELLM_BASE_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435/v1
LITELLM_CHAT_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435/v1/chat/completions

# Leave blank if the HTW endpoint does not require an API key.
# If a key is required, enter it only in the server's local .env.
LITELLM_API_KEY=

LITELLM_MODEL=qwen3.8-27b
LITELLM_VERIFY_TLS=true
LITELLM_TRUST_ENV=true
LITELLM_TIMEOUT=420
LITELLM_MAX_ATTEMPTS=6

# Validated Qwen configuration for this HANS release.
LITELLM_ENABLE_THINKING=false
LITELLM_THINKING_CONTROL=chat_template_kwargs


# ------------------------------------------------------------
# Retrieval / prompt configuration
# ------------------------------------------------------------
HANS_RETRIEVAL_STANDARD_TOP_K=5
HANS_RETRIEVAL_HIGH_RISK_TOP_K=8
FINAL_SOURCE_LIMIT=8
HANS_EVIDENCE_CHARS_PER_DOC=1800


# ------------------------------------------------------------
# Safety / staff review
# ------------------------------------------------------------
THREAD_MEMORY_ENABLED=true
STAFF_REVIEW_REQUIRED_FOR_ALL=true


# ------------------------------------------------------------
# Optional mailbox integration
# Disabled for the initial test-server deployment.
# ------------------------------------------------------------
HANS_MAILBOX_ENABLED=false
HANS_MAILBOX_WRITE_ENABLED=false
HANS_MAILBOX_SEND_ENABLED=false
# Staff UI evaluation logging
HANS_UI_EVAL_LOGGING=true
