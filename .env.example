HANS_ENVIRONMENT=development

HANS_API_HOST=127.0.0.1
HANS_API_PORT=8009

# Internal authentication between n8n and HANS
HANS_INTERNAL_API_KEY=replace-with-a-long-random-secret

HANS_UI_API_URL=http://127.0.0.1:8009
HANS_UI_API_TIMEOUT=720
HANS_UI_EVAL_LOGGING=false

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hans

# HTW-hosted Ollama generation
OLLAMA_BASE_URL=https://f2ki-h100-1.f2.htw-berlin.de:11435
OLLAMA_MODEL=qwen3:32b
OLLAMA_VERIFY_SSL=true
OLLAMA_TIMEOUT=420
OLLAMA_MAX_ATTEMPTS=6

THREAD_MEMORY_ENABLED=true
STAFF_REVIEW_REQUIRED_FOR_ALL=true

RETRIEVAL_TOP_K_PER_TOPIC=6
FINAL_SOURCE_LIMIT=8
MAX_EMAIL_CHARACTERS=20000

DISCLAIMER_PATH=config/disclaimer.md