        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var email_id_text = email_id == null ? "" : String(email_id);

var thread_id = "GMAIL-DEMO-" + email_id_text;

var language = "en";

var sender_text = sender_email == null ? "" : String(sender_email).trim();

var email_match = sender_text.match(/&lt;([^&lt;&gt;]+)>/);

var recipient_email =
    email_match &amp;&amp; email_match.length > 1
        ? email_match[1].trim()
        : sender_text;</jsScript_script>
      </jsScript>
