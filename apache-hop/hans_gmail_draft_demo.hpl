  <transform>
    <type>ScriptValueMod</type>
    <name>05 - Build HANS Request</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var request_json = JSON.stringify({
    email_text: email_text == null ? "" : String(email_text),
    student_email: recipient_email == null ? "" : String(recipient_email),
    subject: subject == null ? "" : String(subject),
    thread_id: thread_id == null ? "" : String(thread_id),
    email_id: email_id == null ? "" : String(email_id),
    language: language == null ? "en" : String(language),
    top_k: 6
});

var base_url = hans_api_url == null ? "" : String(hans_api_url).trim();

base_url = base_url.replace(/\/+$/, "");

var hans_draft_url = base_url + "/v1/drafts";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>request_json</name>
        <rename>request_json</rename>
        <type>String</type>
        <length>50000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>hans_draft_url</name>
        <rename>hans_draft_url</rename>
        <type>String</type>
        <length>500</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
