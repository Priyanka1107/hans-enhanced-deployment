  <transform>
    <type>ScriptValueMod</type>
    <name>02 - Determine HANS Relevance</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var subject_text =
    (subject == null ? "" : String(subject)).toLowerCase();

var body_text =
    (email_text == null ? "" : String(email_text)).toLowerCase();

var combined_text = subject_text + " " + body_text;

var is_hans_relevant =
    combined_text.indexOf("application") >= 0 ||
    combined_text.indexOf("apply") >= 0 ||
    combined_text.indexOf("admission") >= 0 ||
    combined_text.indexOf("deadline") >= 0 ||
    combined_text.indexOf("document") >= 0 ||
    combined_text.indexOf("uni-assist") >= 0 ||
    combined_text.indexOf("programme") >= 0 ||
    combined_text.indexOf("program") >= 0 ||
    combined_text.indexOf("master") >= 0 ||
    combined_text.indexOf("bachelor") >= 0 ||
    combined_text.indexOf("bewerbung") >= 0 ||
    combined_text.indexOf("bewerbungsfrist") >= 0 ||
    combined_text.indexOf("zulassung") >= 0 ||
    combined_text.indexOf("unterlagen") >= 0 ||
    combined_text.indexOf("studiengang") >= 0 ||
    combined_text.indexOf("sprachnachweis") >= 0;

var hans_route =
    is_hans_relevant ? "HANS" : "SKIP";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>subject_text</name>
        <rename>subject_text</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
